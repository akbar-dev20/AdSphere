# Copy this file to .env and fill in your existing Supabase project values.
# These must be the project URL and publishable/anon key only.
#
# Where to find them:
#   Supabase Dashboard → Project Settings → API
#     - Project URL        → VITE_SUPABASE_URL
#     - anon / publishable key → VITE_SUPABASE_ANON_KEY
#
# For CI deploys, add the same two values as repository secrets
# (Settings → Secrets and variables → Actions) with these exact names:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
